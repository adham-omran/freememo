.clj-kondo/.cache
.cpcache
.lsp
.idea
.nrepl-port
.shadow-cljs
node_modules
/resources/public/electric_starter_app/js
/resources/electric-manifest.edn
/target
.DS_Store
/.dir-locals.el
.clj-kondo
/resources/google_client.json
/resources/openai.txt
/.env
logs/
/resources/public/freememo/js/
/.calva/
