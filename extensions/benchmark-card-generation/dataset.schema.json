{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freememo.app/schemas/card-generation-benchmark-dataset-v1.json",
  "title": "Card generation benchmark dataset",
  "type": "object",
  "required": ["dataset_id", "version", "sources"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "smoke_test": {"type": "boolean"},
    "reference_policy": {"enum": ["all-tiers-v1", "at-least-two-v1"]},
    "provenance": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_text", "target_units"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_text": {"type": "string", "minLength": 1},
          "source_meta": {"type": "object"},
          "target_units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["unit_id", "highlight", "intent", "reference_cards"],
              "properties": {
                "unit_id": {"type": "string", "minLength": 1},
                "highlight": {"type": "string", "minLength": 1},
                "intent": {"type": "string", "minLength": 1},
                "reference_cards": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["id", "tier", "front", "back", "rationale"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "tier": {"enum": ["T0", "T1", "T2", "T3"]},
                      "front": {"type": "string", "minLength": 1},
                      "back": {"type": "string", "minLength": 1},
                      "rationale": {"type": "string", "minLength": 1},
                      "source_task_type": {"type": "string", "minLength": 1},
                      "source_test_target": {"type": "boolean"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
